<!-- Example -->
<group name="local,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>



<!-- SOAR PHISHING EMAIL DETECTION -->


  <!-- Rule 100500: Identify n8n phishing events -->
  <rule id="100500" level="0">
    <decoded_as>json</decoded_as>
    <field name="integration">^n8n_phishing$</field>
    <field name="event_type">^phishing_url_analysis$</field>
    <description>SOAR: Phishing URL analysis event received from n8n.</description>
    <group>soar,phishing,</group>
  </rule>

  <!-- Rule 100501: Malicious URL -->
  <rule id="100501" level="12">
    <if_sid>100500</if_sid>
    <field name="vt_malicious" type="pcre2">^[1-9][0-9]*$</field>
    <description>SOAR: MALICIOUS URL detected by VirusTotal - $(url) - Domain: $(domain) - Malicious: $(vt_malicious)</description>
    <group>soar,phishing,malicious,</group>
  </rule>

  <!-- Rule 100502: Suspicious URL -->
  <rule id="100502" level="8">
    <if_sid>100500</if_sid>
    <field name="vt_malicious">^0$</field>
    <field name="vt_suspicious" type="pcre2">^[1-9][0-9]*$</field>
    <description>SOAR: SUSPICIOUS URL detected by VirusTotal - $(url) - Domain: $(domain) - Suspicious: $(vt_suspicious)</description>
    <group>soar,phishing,suspicious,</group>
  </rule>


  <!-- ====================================== -->
  <!-- SOAR PHISHING FILE ANALYSIS RULES      -->
  <!-- ====================================== -->

  <!-- Rule 100510: Identify n8n file events -->
  <rule id="100510" level="0">
    <decoded_as>json</decoded_as>
    <field name="integration">^n8n_phishing$</field>
    <field name="event_type">^phishing_file_analysis$</field>
    <description>SOAR: Phishing FILE analysis event received from n8n.</description>
    <group>soar,phishing,file,</group>
  </rule>

  <!-- Rule 100511: Malicious File -->
  <rule id="100511" level="12">
    <if_sid>100510</if_sid>
    <field name="vt_malicious" type="pcre2">^[1-9][0-9]*$</field>
    <description>SOAR: MALICIOUS FILE detected by VirusTotal - $(file_name) - SHA256: $(file_sha256) - Malicious engines: $(vt_malicious)</description>
    <group>soar,phishing,file,malicious,</group>
  </rule>

  <!-- Rule 100512: Suspicious File -->
  <rule id="100512" level="8">
    <if_sid>100510</if_sid>
    <field name="vt_malicious">^0$</field>
    <field name="vt_suspicious" type="pcre2">^[1-9][0-9]*$</field>
    <description>SOAR: SUSPICIOUS FILE detected by VirusTotal - $(file_name) - SHA256: $(file_sha256) - Suspicious engines: $(vt_suspicious)</description>
    <group>soar,phishing,file,suspicious,</group>
  </rule>

  <!-- Rule 100513: File requires manual review -->
  <rule id="100513" level="5">
    <if_sid>100510</if_sid>
    <field name="vt_malicious">^0$</field>
    <field name="vt_suspicious">^0$</field>
    <field name="file_verdict">^review$</field>
    <description>SOAR: FILE requires manual review - $(file_name) - SHA256: $(file_sha256) - Severity: $(file_severity) - Sigma medium: $(sigma_medium)</description>
    <group>soar,phishing,file,review,</group>
  </rule>

</group>
